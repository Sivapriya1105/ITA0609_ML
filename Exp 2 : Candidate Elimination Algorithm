import pandas as pd
import numpy as np

# Create dataset
data = pd.DataFrame({
    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],
    'AirTemp': ['Warm', 'Warm', 'Cold', 'Warm'],
    'Humidity': ['Normal', 'High', 'High', 'High'],
    'Wind': ['Strong', 'Strong', 'Strong', 'Strong'],
    'Water': ['Warm', 'Warm', 'Warm', 'Cool'],
    'Forecast': ['Same', 'Same', 'Change', 'Change'],
    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']
})

concepts = np.array(data.iloc[:, :-1])
target = np.array(data.iloc[:, -1])

def candidate_elimination(concepts, target):
    specific = concepts[0].copy()
    general = [['?' for _ in range(len(specific))] for _ in range(len(specific))]

    for i, h in enumerate(concepts):
        if target[i] == "Yes":
            for x in range(len(specific)):
                if h[x] != specific[x]:
                    specific[x] = '?'
                    general[x][x] = '?'
        else:
            for x in range(len(specific)):
                if h[x] != specific[x]:
                    general[x][x] = specific[x]
                else:
                    general[x][x] = '?'

    general = [g for g in general if g != ['?'] * len(specific)]
    return specific, general

s, g = candidate_elimination(concepts, target)

print("Specific Hypothesis:")
print(s)

print("\nGeneral Hypothesis:")
for hypothesis in g:
    print(hypothesis)
